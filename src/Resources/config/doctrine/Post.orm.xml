<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
    <entity name="App\Entity\Post" table="post" repository-class="App\Repository\PostRepository">
        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="code" type="string" unique="true" nullable="true" column="code"/>
        <field name="body" type="text"  column="body"/>

        <one-to-one field="parent" target-entity="App\Entity\Topic" mapped-by="mainPost">
            <cascade>
                <cascade-all/>
            </cascade>
        </one-to-one>

        <many-to-one field="topic" target-entity="App\Entity\Topic" inversed-by="posts">
            <join-columns>
                <join-column name="topic_id" referenced-column-name="id" on-delete="CASCADE"/>
            </join-columns>
            <cascade>
                <cascade-persist />
            </cascade>
        </many-to-one>


        <many-to-one field="author" target-entity="Sylius\Component\Customer\Model\CustomerInterface">
            <join-columns>
                <join-column name="author_id" referenced-column-name="id"/>
            </join-columns>
            <cascade>
                <cascade-persist />
            </cascade>
        </many-to-one>

        <many-to-one field="replyTo" target-entity="App\Entity\Post" inversed-by="replies">
            <join-column name="reply_to_id" referenced-column-name="id"/>
        </many-to-one>

        <one-to-many field="replies" target-entity="App\Entity\Post" mapped-by="replyTo">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <field name="createdAt" type="datetime" column="created_at">
            <gedmo:timestampable on="create"/>
        </field>
        <field name="updatedAt" type="datetime" column="updated_at">
            <gedmo:timestampable on="update"/>
        </field>
    </entity>
</doctrine-mapping>
