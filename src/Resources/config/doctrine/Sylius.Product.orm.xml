<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
  <entity repository-class="App\Entity\Sylius\ProductRepository" name="App\Entity\Sylius\Product" table="sylius_product">
    <field name="deletedAt" type="datetime" column="deleted_at" nullable="true"/>
    <gedmo:soft-deleteable field-name="deletedAt" time-aware="false" hard-delete="false" />
    <one-to-many field="options" target-entity="App\Entity\Sylius\ProductOptions" mapped-by="product" orphan-removal="true" fetch="EAGER">
      <cascade>
        <cascade-remove/>
        <cascade-persist/>
      </cascade>
    </one-to-many>
    <one-to-many field="attributes" target-entity="Sylius\Component\Product\Model\ProductAttributeValue" mapped-by="subject" orphan-removal="true" fetch="EAGER">
      <cascade>
        <cascade-all/>
      </cascade>
    </one-to-many>
      <one-to-many field="variants" target-entity="App\Entity\Sylius\ProductVariant" mapped-by="product" orphan-removal="true">
          <cascade>
              <cascade-all/>
          </cascade>
          <order-by>
              <order-by-field name="position" direction="ASC"/>
          </order-by>
      </one-to-many>
    <one-to-many field="images" target-entity="App\Entity\Sylius\ProductImage" mapped-by="product" orphan-removal="true" fetch="EAGER">
      <cascade>
        <cascade-all/>
      </cascade>
    </one-to-many>
    <many-to-one field="business" target-entity="App\Entity\LocalBusiness" inversed-by="products">
      <join-column name="business_id" referenced-column-name="id" />
    </many-to-one>

      <field name="type" type="string" column="type">
          <options>
              <option name="default">common</option>
          </options>
      </field>
  </entity>
</doctrine-mapping>
