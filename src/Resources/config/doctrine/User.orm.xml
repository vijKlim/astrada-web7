<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
  <entity repository-class="App\Entity\UserRepository" name="App\Entity\User" table="api_user">
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="quotesAllowed" type="boolean" column="quotes_allowed">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="createdAt" type="datetime" column="created_at">
      <gedmo:timestampable on="create"/>
    </field>
    <field name="updatedAt" type="datetime" column="updated_at">
      <gedmo:timestampable on="update"/>
    </field>
      <one-to-one field="customer" target-entity="Sylius\Component\Customer\Model\CustomerInterface" inversed-by="user">
          <cascade>
              <cascade-persist/>
          </cascade>
          <join-column name="customer_id" referenced-column-name="id" nullable="false" />
      </one-to-one>
      <many-to-many field="businesses" target-entity="App\Entity\LocalBusiness" inversed-by="owners">
          <cascade>
              <cascade-all/>
          </cascade>
          <join-table name="api_user_business">
              <join-columns>
                  <join-column name="api_user_id" referenced-column-name="id" on-delete="CASCADE"/>
              </join-columns>
              <inverse-join-columns>
                  <join-column name="business_id" referenced-column-name="id" nullable="true"/>
              </inverse-join-columns>
          </join-table>
      </many-to-many>
      <one-to-many field="bookings" target-entity="App\Entity\Booking" mapped-by="user" orphan-removal="true">
          <order-by>
              <order-by-field name="createdAt" direction="DESC"/>
          </order-by>
          <cascade>
              <cascade-persist/>
              <cascade-remove/>
          </cascade>
      </one-to-many>
  </entity>
</doctrine-mapping>
