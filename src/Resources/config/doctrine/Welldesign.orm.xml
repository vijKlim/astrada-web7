<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\Welldesign" table="welldesign">
        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="title" type="string" column="title" nullable="true"/>
        <field name="description" type="text" column="description" nullable="true"/>
        <field name="pipeDiameter" type="string" column="pipe_diameter" length="50" nullable="true"/>
        <field name="depthFrom" type="smallint" column="depth_from"/>
        <field name="depthTo" type="smallint" column="depth_to"/>
        <field name="vehicleType" type="string" column="vehicle_type" length="50" nullable="true"/>
        <field name="price" type="integer" column="price"/>

        <many-to-one field="listing" target-entity="App\Entity\Listing" inversed-by="welldesigns">
            <join-column name="listing_id" referenced-column-name="id" />
        </many-to-one>
    </entity>
</doctrine-mapping>
