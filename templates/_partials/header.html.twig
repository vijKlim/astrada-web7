<header class="header">
    <!-- Navbar-->
    <nav class="navbar navbar-expand-lg fixed-top shadow navbar-light bg-white">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <a class="navbar-brand py-1" href="{{ path('homepage') }}">
                    <img src="{{ asset('img/logo_astrada2.png') }}" alt="{{ astrada_setting('brand_name') }}">
{#                    <img src="{{ astrada_company_logo() }}" alt="{{ astrada_setting('brand_name') }}">#}
                </a>
                {{ render(controller('App\\Controller\\ListingSearchController::searchHeaderFormAction')) }}

            </div>
            <button class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa fa-bars"></i>
            </button>
            <!-- Navbar Collapse -->
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <form class="form-inline mt-4 mb-2 d-sm-none" action="#" id="searchcollapsed">
                    <div class="input-label-absolute input-label-absolute-left input-reset w-100">
                        <label class="label-absolute" for="searchcollapsed_search"><i class="fa fa-search"></i><span class="sr-only">What are you looking for?</span></label>
                        <input class="form-control form-control-sm border-0 shadow-0 bg-gray-200" id="searchcollapsed_search" placeholder="Search" aria-label="Search">
                        <button class="btn btn-reset btn-sm" type="reset"><i class="fa-times fas">           </i></button>
                    </div>
                </form>
                <ul class="navbar-nav ml-auto">

                    <li class="nav-item"><a class="nav-link" href="contact.html">{% trans %}navbar.contact{% endtrans %}</a>
                    </li>


                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item mt-3 mt-lg-0 ml-lg-3 d-lg-none d-xl-inline-block">
                            <a class="btn btn-primary" href="{{ path('admin_index') }}">{% trans %}adminDashboard.short_title{% endtrans %}</a>
                        </li>
                    {% endif %}

                    {% if app.user %}
                        {% include '_partials/user/account_dropdown.html.twig' %}
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('nucleos_user_security_login') }}">{% trans %}navbar.login{% endtrans %}</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('nucleos_profile_registration_register') }}">{% trans %}navbar.signup{% endtrans %}</a></li>
                        <li class="nav-item mt-3 mt-lg-0 ml-lg-3 d-lg-none d-xl-inline-block"><a class="btn btn-primary" href="user-add-0.html">{{ 'nav.add_point'|trans }}</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
    <!-- /Navbar -->
</header>