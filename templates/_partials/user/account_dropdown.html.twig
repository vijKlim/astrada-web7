<li class="nav-item dropdown ml-lg-3">
    <a id="userDropdownMenuLink" href="#" data-toggle="dropdown"
       aria-haspopup="true" aria-expanded="false">
        <img class="avatar avatar-sm avatar-border-white mr-2" src="{{ path('user_avatar', { username: app.user.username }) }}" alt="{{ app.user.username }}">
    </a>
    <div class="dropdown-menu dropdown-menu-right"
         aria-labelledby="userDropdownMenuLink">
        <a class="dropdown-item" href="{{ path('nucleos_profile_profile_show') }}">{% trans %}navbar.myAccount{% endtrans %} </a>

        {% if is_granted('DASHBOARD_VIEW') %}
            <a class="dropdown-item" href="{{ path('dashboard') }}">{{ 'adminDashboard.dashboard.title'|trans }} </a>
        {% endif %}
        <div class="dropdown-divider"></div>
        <a class="dropdown-item" href="{{ path('nucleos_user_security_logout') }}">
            <i class="fas fa-sign-out-alt mr-2 text-muted"></i> {% trans %}navbar.logout{% endtrans %}
        </a>
    </div>
</li>