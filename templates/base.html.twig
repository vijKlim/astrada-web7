<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    {{ sonata_seo_title() }}
    {{ sonata_seo_link_canonical() }}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000" />
    <link rel="shortcut icon" href="/img/favicon.png">
    {{ sonata_seo_metadatas() }}

    <!-- Google fonts - Playfair Display-->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Playfair+Display:400,400i,700">
    <!-- Google fonts - Poppins-->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,400i,700">
    <!-- swiper-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.4.1/css/swiper.min.css">

    <!-- Tweaks for older IEs--><!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script><![endif]-->
    <!-- Font Awesome CSS-->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" integrity="sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf" crossorigin="anonymous">

    {{ encore_entry_link_tags('frontend-common') }}

    {% if app.user %}
        {{ encore_entry_link_tags('notifications') }}
    {% endif %}
    {% block styles_common %}
        {% block styles %}{% endblock %}
    {% endblock %}
    {% block structured_data %}{% endblock %}

    <link rel="preconnect" href="{{ cdn_root_url }}" />
</head>
<body style="padding-top: 72px;" data-country="{{ country_iso }}" data-currency-symbol="{{ currency_context.currencyCode|sylius_currency_symbol }}" data-timezone="{{ astrada_setting('timezone') }}">
<!-- allow a user to go to the main content of the page -->
<noscript>Javascript must be enabled for the correct page display</noscript>



{% block flash_messages %}
    {% include '_partials/flash_messages.html.twig' %}
{% endblock %}

{% block layout %}{% endblock %}

{% if app.environment == "prod" %}
    <script
            src="https://browser.sentry-cdn.com/6.2.4/bundle.min.js"
            integrity="sha384-b3mYy/x0ZxlqU5OjYvVD7RczftJVOXmpHSmrcqpL4c+kBSXWEnRL2Puv9eMjYmDq"
            crossorigin="anonymous"
    ></script>
    <script>
        Sentry.init({ dsn: '{{ sentry_public_dsn }}' });
    </script>
{% endif %}

<div id="cpccl_settings"
     data-latlng="{{ astrada_setting('latlng')|json_encode|e('html_attr') }}"></div>

<script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

<div id="user_location" data-latlng="{{ astrada_user_location()|json_encode|e('html_attr') }}"></div>

{{ encore_entry_script_tags('frontend-common') }}
{{ encore_entry_script_tags('widgets') }}


{#<script src="{{ asset('bundles/tetranzselect2entity/js/select2entity.js') }}"></script>#}
{% if app.user %}
    {{ encore_entry_script_tags('notifications') }}
{% endif %}

{% include '_partials/autocomplete_adapter.html.twig' %}

{# We load Google Maps *SYNCHRONOUSLY*, so this must be added *BEFORE* scripts, so that Google is loaded #}
{# https://developers.google.com/maps/documentation/javascript/examples/map-sync #}
{% include '_partials/google_maps.html.twig' %}

{% block scripts_common %}
    {% block scripts %}{% endblock %}
{% endblock %}

{% if app.environment == "test" %}
    <script>
        {% include '_partials/error_handler.js.twig' %}
    </script>
{% endif %}

{% include "_partials/analytics.html.twig" %}

{{ encore_entry_script_tags('frontend-search-address') }}
</body>
</html>
