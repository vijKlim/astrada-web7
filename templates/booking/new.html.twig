{% extends "base.html.twig" %}

{% block layout %}
    {% embed 'layout.html.twig'%}




        {% block main %}
            {% set listing = booking.listing %}
            {% set listing_translation = listing.translations[app.request.locale] %}
            {% set listing_location = listing.address %}
            {% if listing.images|length > 0 %}
                {% set first_image = listing.images|first %}
                {% set listing_image = astrada_asset(first_image, 'imageFile', 'listing_thumbnail') %}

            {% else %}
                {% set listing_image = '//via.placeholder.com/512.jpg' %}
            {% endif %}
            {% set listing_path_params = {} %}
{#            {% set booking_duration = booking.duration(endDayIncluded, timeUnit) %}#}

            <div class="progress rounded-0 sticky-top" style="height: 8px; top: 71px;">
                <div class="progress-bar" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <section class="py-5">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-7">
                            <p class="subtitle text-primary">Заявка на бурение скважины</p>
                            <h1 class="h2 mb-5">Информация</h1>



                            <div class="text-block">
                                <div class="media">
                                    <div class="media-body">
                                        <p class="text-sm text-muted">Вы можете добавить дополнительную информацию к вашей заявке.</p>
                                    </div>
                                </div>
                                <textarea class="form-control" name="hello" rows="4"></textarea>
                            </div>
                            <div class="row form-block flex-column flex-sm-row">

                                <div class="col text-center text-sm-right"><a class="btn btn-primary px-3" href="user-booking-3.html"> Отправить<i class="fa-chevron-right fa ml-2"></i></a></div>
                            </div>
                        </div>
                        <div class="col-lg-5 pl-xl-5">
                            <div class="card border-0 shadow">
                                <div class="card-body p-4">
                                    <div class="text-block pb-3">
                                        <div class="media align-items-center">
                                            <div class="media-body">
                                                <h6> <a class="text-reset" href="detail-rooms.html">{{ listing_translation.title }}</a></h6>
                                                <p class="text-muted text-sm mb-0">{{ listing.business.name }}</p>
                                                <div class="mt-n1"><i class="fa fa-xs fa-star text-primary"></i><i class="fa fa-xs fa-star text-primary"></i><i class="fa fa-xs fa-star text-primary"></i><i class="fa fa-xs fa-star text-primary"></i><i class="fa fa-xs fa-star text-gray-200"></i>
                                                </div>
                                            </div><a href="{{ listing_path(listing, listing_path_params) }}"><img class="ml-3 rounded" src="{{ listing_image }}" alt="" width="100"></a>
                                        </div>
                                    </div>
                                    <div class="text-block py-3">
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-3"><i class="fas fa-users fa-fw text-muted mr-2"></i>{{ listing.address.streetAddress }}</li>
                                            <li class="mb-0"><i class="far fa-calendar fa-fw text-muted mr-2"></i>Apr 17, 2019 <i class="fas fa-arrow-right fa-fw text-muted mx-3"></i>Apr 18, 2019</li>
                                        </ul>
                                    </div>
                                    <div class="text-block pt-3 pb-0">
                                        <table class="w-100">
                                            <tbody>
                                            <tr>
                                                <th class="font-weight-normal py-2">{{ 'listing.price.per_1km_delivery'|trans }}</th>
                                                <td class="text-right py-2">{{ listing.welldesign.transportationCost|price_format }}</td>
                                            </tr>
                                            <tr>
                                                <th class="font-weight-normal pt-2 pb-3">{{ 'listing.price.per_1m_drilling'|trans }}</th>
                                                <td class="text-right pt-2 pb-3">{{ listing.welldesign.wellCost|price_format }}</td>
                                            </tr>
                                            </tbody>

                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {% endblock %}

    {% endembed %}
{% endblock %}

{#{% block styles %}#}
{#    {{ encore_entry_link_tags('frontend-map-detail') }}#}
{#{% endblock %}#}

{#{% block scripts %}#}
{#    {{ encore_entry_script_tags('frontend-map-detail') }}#}
{#{% endblock %}#}