
{% form_theme form 'form/frontend/register.html.twig' %}

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-6 mb-6 mb-md-0">
                <div class="mb-4">
                    <h2>{% trans from 'messages' %}base.signup_on{% endtrans %} {{ astrada_setting('brand_name') }}</h2>
                    <p class="text-muted">
                        {% trans from 'messages' %}base.signup_description{% endtrans %}
                    </p>
                </div>
                <div class="media">
                    <svg class="svg-icon svg-icon svg-icon-light w-3rem h-3rem mr-3 text-primary">
                        <use xlink:href="#identity-1"> </use>
                    </svg>
                    <div class="media-body">
                        <h4 class="h6 subtitle text-sm text-primary">Особистий кабінет</h4>
                        <ul class="text-sm text-muted font-weight-light">
                            <li>Розміщення запитів на буріння свердловин на воду</li>
                            <li>Зберігайте вигідні пропозиції, для швидкого пошуку</li>
                        </ul>

                    </div>

                </div>
                <br>
                <div class="media">
                    <svg class="svg-icon svg-icon svg-icon-light w-3rem h-3rem mr-3 text-primary">
                        <use xlink:href="#map-location-1"> </use>
                    </svg>
                    <div class="media-body">
                        <h4 class="h6 subtitle text-sm text-primary">Розміщення своїх оголошень</h4>
                        <ul class="text-sm text-muted font-weight-light">
                            <li>Бурові роботи</li>
                            <li>Обслуговування свердловин</li>
                            <li>Встановлення обладнання</li>
                        </ul>
                    </div>

                </div>
                <br>
                <div class="media">
                    <svg class="svg-icon svg-icon svg-icon-light w-3rem h-3rem mr-3 text-primary">
                        <use xlink:href="#dollar-sign-1"> </use>
                    </svg>
                    <div class="media-body">
                        <h4 class="h6 subtitle text-sm text-primary">Стати партнером</h4>
                        <ul class="text-sm text-muted font-weight-light">
                            <li>Постачання комплектуючих</li>
                        </ul>

                    </div>

                </div>
                <br>
                <div class="media">
                    <p class="text-muted">
                        Детальніше про &nbsp;<a href="">функції порталу</a>.
                    </p>
                </div>
            </div>
            <div class="col-md-6 mb-6 mb-md-0">
                {{ form_start(form, {'method': 'post', 'action': path('nucleos_profile_registration_register'), 'attr': {'class': 'nucleos_profile_registration_register form-validate'}}) }}
                <div class="text-secondary">
                    {{ form_errors(form) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.email, null, { label_attr: { class: 'form-label' } }) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'} }) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.username, null, { label_attr: { class: 'form-label' } }) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-control'} }) }}
                </div>

                {{ form_widget(form.plainPassword) }}


                <div class="form-group mb-4">
                    <div class="custom-control custom-checkbox">
                        {{ form_widget(form.legal, {'attr': {'class': 'custom-control-input'} }) }}
                        {{ form_label(form.legal, null, { label_attr: { class: 'custom-control-label text-muted' } }) }}
                    </div>
                </div>



                {{ form_widget(form.save, { attr: { class: 'btn btn-lg btn-block btn-primary' } }) }}


                <hr class="my-3 hr-text letter-spacing-2" data-content="OR">
                <button class="btn btn btn-outline-primary btn-block btn-social mb-3"><i class="fa-2x fa-facebook-f fab btn-social-icon"> </i>Connect <span class="d-none d-sm-inline">with Facebook</span></button>
                <button class="btn btn btn-outline-muted btn-block btn-social mb-3"><i class="fa-2x fa-google fab btn-social-icon"> </i>Connect <span class="d-none d-sm-inline">with Google</span></button>
                <hr class="my-4">
                <p class="text-sm text-muted">By signing up you agree to Directory's <a href="#">Terms and Conditions</a> and <a href="#">Privacy Policy</a>.</p>
                {{ form_end(form) }}

            </div>
        </div>
    </div>

</section>
