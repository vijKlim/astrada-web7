{% set page_count = pagination.pages_count %}
{% set page = pagination.page %}

{% if page_count > 1 %}

    <nav aria-label="Page navigation">
        <ul class="pagination pagination-template d-flex justify-content-center">
            {% if page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(pagination.route, pagination.route_params|merge({'page': page - 1})) }}">
                        <i class="fa fa-angle-left"></i>
                    </a>
                </li>
            {% endif %}

            {#display p numbers only from p-4 to p+4 but don't go <1 or >pages_count#}
            {% for p in range(max(pagination.page-4, 1), min(page + 4, page_count)) %}
                <li class="page-item {% if p == page %}active{% endif %}">
                    <a class="page-link" href="{{ path(pagination.route, pagination.route_params|merge({'page': p})) }}">{{ p }}</a>
                </li>
            {% endfor %}

            {% if page < page_count %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(pagination.route, pagination.route_params|merge({'page': page + 1})) }}">
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
            {% endif %}

        </ul>
    </nav>

{% endif %}


