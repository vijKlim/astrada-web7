<form   class="add-comment custom-form">
    <fieldset>
        <label><i class="fal fa-user"></i></label>
        <input type="text" placeholder="Your Name *" value=""/>
        <div class="clearfix"></div>
        <label><i class="fal fa-envelope"></i>  </label>
        <input type="text" placeholder="Email Address*" value=""/>
        <div class="quantity fl-wrap">
            <span><i class="fal fa-user-plus"></i>Persons : </span>
            <div class="quantity-item">
                <input type="button" value="-" class="minus">
                <input type="text"    name="quantity"   title="Qty" class="qty color-bg" data-min="1" data-max="3" data-step="1" value="1">
                <input type="button" value="+" class="plus">
            </div>
        </div>
        <div class="listsearch-input-item clact date-container2">
            <label><i class="fal fa-calendar"></i></label>
            <input type="text" placeholder="Date / Time"     name="datepicker-here-time"   value=""/>
            <span class="clear-singleinput"><i class="fal fa-times"></i></span>
        </div>
        <textarea cols="40" rows="3" placeholder="Additional Information:"></textarea>
    </fieldset>
    <button class="btn color2-bg url_btn float-btn" onclick="window.location.href='booking.html'">Book Table Now <i class="fal fa-bookmark"></i></button>
</form>

<section class="widget reservation ajax-container">
    {% if app.request.isXmlHttpRequest %}
        {% include 'CocoricoCoreBundle:Frontend/Common:_flash.html.twig' %}
    {% endif %}

    {{ form_start(form, {'attr': {'id': 'booking-form', 'class': 'date-selection'}}) }}

    {{ form_errors(form) }}

    <fieldset>
        <legend class="hidden">date-selection</legend>

        {{ form_widget(form.date_range) }}

        <input type="submit" class="hidden">
    </fieldset>

    {{ form_end(form) }}

    <div class="add-info">


        {% if form.vars.submitted and form.vars.valid %}
            <a href="#" data-id="submit-booking" class="btn btn-default">{{ 'listing.show.book.now.submit'|trans }}</a>
        {% else %}
            <a disabled data-id="submit-booking" class="btn btn-default">{{ 'listing.show.book.now.submit'|trans }}</a>
        {% endif %}

{#        {% set duration = booking.duration(endDayIncluded, timeUnit) %}#}
{#        {% if duration %}#}
{#            <em class="text">#}
{#                <strong>{{ 'booking.duration:'|trans ~ " " ~ duration|add_time_unit_text }}</strong>#}
{#            </em>#}
{#        {% endif %}#}



        <em class="text small">*{{ 'listing.show.excluding_booking_fees'|trans }}</em>
    </div>


    <script>
        $(function () {
            var timeUnitIsDay = {{ astrada_is_timeUnitIsDay() ? 'true' : 'false' }};

            initDatePickerAjax(function () {
                jcf.replaceAll("#booking-form");
            });

            var $form = $("#booking-form");

            $form.submit(function () {
                //Remove price and submit button
                //Disable fields and add loading until form is rendered
                $(this).find("input").attr("readonly", "readonly");
                $(this).find("select option:not(:selected)").each(function () {
                    $(this).attr('disabled', 'disabled');
                });
                $(".add-info .price, .add-info .loading, a[data-id=submit-booking]").remove();
                $(".add-info").prepend('<img class="loading" src="{{ asset("images/loading.gif") }}" /><br>');
            });

            $("a[data-id=submit-booking]").click(function (e) {
                e.preventDefault();
                var $errors = $form.find('div.errors');
                //Submit form if no errors
                if (!$errors.length || ($errors.length && !$errors.is(":visible"))) {
                    if ($("#start-date").val() && $("#end-date").val()) {
                        if (timeUnitIsDay) {
                            $form.submit();
                        } else {
                            var $holderTimes = $form.find(".time-fields");
                            var $startHour = $holderTimes.find("[id$=_start_hour]").first();
                            var $endHour = $holderTimes.find("[id$=_start_minute]").first();
                            var $startMinute = $holderTimes.find("[id$=_end_hour]").first();
                            var $endMinute = $holderTimes.find("[id$=_end_minute]").first();

                            if ($startHour.val() && $endHour.val() && $startMinute.val() && $endMinute.val()) {
                                $form.submit();
                            }
                        }
                    }
                }
            });

        });
    </script>
</section>
