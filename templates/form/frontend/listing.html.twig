{#
    Date range widget
#}
{%- block date_range_widget -%}

    <div class="form-group">
        {{ form_errors(form.start) }}
        {% if form.start.vars.label %}
            <label class="form-label" for="bookingDate">{{ form_label(form.start) }}</label>

        {% endif %}
        <div class="datepicker-container datepicker-container-right">
            {{ form_widget(form.start,{
                'type': 'text',
                'attr': {

                    'class': 'form-control ' ~ form.start.vars.attr.class|default(''),
                    'placeholder': "/      /",
                    'id': 'bookingDate'
                }
            }) }}

        </div>
    </div>

    {% if form.nb_days is defined %}
        {% if "hidden" not in form.nb_days.vars.block_prefixes %}

            <div class="form-group mb-4">
                <label class="form-label" for="guests">{{ form_label(form.nb_days) }}</label>
                {{ form_errors(form.nb_days) }}
                {{ form_widget(form.nb_days, {'attr': { 'class': 'form-control'}}) }}
            </div>

        {% else %}
            {#hidden#}
            {{ form_errors(form.nb_days) }}
            {{ form_widget(form.nb_days) }}
        {% endif %}
    {% endif %}



{%- endblock -%}