{% block _createListing_business_ownerType_widget %}
    <div class="btn-group btn-group-toggle" data-toggle="buttons">
        {% for child in form %}
            {% set value = child.vars.value %}
            {% set checked = child.vars.checked %}
            {% set label = child.vars.label %}
            <label class="btn btn-outline-primary btn-toggle {% if checked %}active{% endif %}">
                <input type="radio" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} /> {{ label }}
            </label>
        {% endfor %}

    </div>
{% endblock %}

{% block _createListing_business_address_widget %}
    <div class="form-group">
        <label class="form-label" for="guests">{{ form_label(form.streetAddress) }}</label>
        {{ form_errors(form.streetAddress) }}
        {{ form_widget(form.streetAddress, {'attr': { 'class': 'form-control'}}) }}
    </div>
    {{ form_row(form.postalCode) }}
    {{ form_row(form.addressLocality) }}
    {{ form_row(form.latitude) }}
    {{ form_row(form.longitude) }}
{% endblock %}

{% block _createListing_listing_address_widget %}

    <div id="{{ form.vars.id }}">

        {% set isNewAddress = (form.isNewAddress.vars.data == true) %}

        {{ form_widget(form.existingAddress,          { attr: { 'class': (isNewAddress ? 'd-none' : '') } }) }}
        {{ form_widget(form.newAddress.streetAddress, { attr: { 'class': (isNewAddress ? '' : 'd-none') } }) }}

        {% if form.rememberAddress is defined %}
            {{ form_widget(form.rememberAddress) }}
        {% endif %}

        {{ form_widget(form.newAddress.postalCode, { attr: { 'data-address-prop': 'postalCode' } }) }}
        {{ form_widget(form.newAddress.addressLocality, { attr: { 'data-address-prop': 'addressLocality' } }) }}
        {{ form_widget(form.newAddress.latitude, { attr: { 'data-address-prop': 'latitude' } }) }}
        {{ form_widget(form.newAddress.longitude, { attr: { 'data-address-prop': 'longitude' } }) }}

        {{ form_widget(form.isNewAddress, { attr: { 'class': 'd-none' } }) }}

    </div>
{% endblock %}

