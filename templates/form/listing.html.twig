{% extends 'bootstrap_3_layout.html.twig' %}

{% block _listing_imageFile_row %}
    {% set image_url = astrada_asset(form.parent.vars.value, 'imageFile', 'listing_thumbnail') %}
    <div class="form-group {% if not form.vars.valid %}has-error{% endif %}">
        <div class="image-uploader"
             {% if image_url is not empty %}style="background-image: url({{ image_url }})"{% endif %}>
            <label for="{{ form.file.vars.id }}" class="btn btn-danger">
                <i class="fa fa-upload"></i> {% trans %}business.form.uploadImage{% endtrans %}
            </label>
            {{ form_widget(form.file) }}
        </div>
        {{ form_errors(form) }}
    </div>
    {% if form.delete is defined %}
        {{ form_row(form.delete) }}
    {% endif %}
{% endblock %}



{% block _listing_welldesign_widget %}
    <div class="row alert alert-warning">
        <div class="col-sm-12">
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        {{ form_label(form.drillingKit) }}
                        {{ form_widget(form.drillingKit) }}
                    </div>

                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label >{% trans %}form.welldesign.transportationCost{% endtrans %}</label>
                        {{ form_row(form.transportationCost, {'label':false}) }}
                    </div>


                </div>
            </div>
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        {{ form_label(form.pipeDiameter) }}
                        {{ form_widget(form.pipeDiameter) }}
                    </div>

                </div>
                <div class="col-sm-3">
                    <label >{% trans %}form.welldesign.depthWell{% endtrans %}</label>
                    <div class="d-flex">
                        <div class="input-group mr-4">
                            {{ form_widget(form.depthFrom, { attr: { size: 2 } }) }}
                            <span class="input-group-addon"><small>{{ form.depthFrom.vars.label|trans }}</small></span>
                        </div>
                        <div class="input-group">
                            {{ form_widget(form.depthTo, { attr: { size: 2 } }) }}
                            <span class="input-group-addon"><small>{{ form.depthTo.vars.label|trans }}</small></span>
                        </div>
                    </div>

                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label >{% trans %}form.welldesign.wellCost{% endtrans %}</label>
                        {{ form_row(form.wellCost, {'label':false}) }}
                    </div>

                </div>
            </div>
        </div>

    </div>


{% endblock %}
