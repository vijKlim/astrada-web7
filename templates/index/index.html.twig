{% extends "base.html.twig" %}

{% block layout %}
    {% embed 'layout.html.twig'%}
        {% block sub_header %}
            <!--section  -->
            <section class="hero-section"   data-scrollax-parent="true">
                <div class="bg-tabs-wrap">
                    <div class="bg-parallax-wrap" data-scrollax="properties: { translateY: '200px' }">
                        <img class="bg bg_tabs"  src="/images/header.jpg"></img>
                        <div class="overlay op7"></div>
                    </div>
                </div>
                <div class="container small-container">
                    <div class="intro-item fl-wrap">
                        <span class="section-separator"></span>
                        <div class="bubbles">
                            <h1>{{ 'home.header.title'|trans|raw }}</h1>
                        </div>
                        <h3>{{ 'home.header.description'|trans|raw }}</h3>
                    </div>
                    <!-- main-search-input-tabs-->
                    <div class="main-search-input-tabs  tabs-act fl-wrap">

                        <!--tabs -->
                        <div class="tabs-container fl-wrap  ">
                            <!--tab -->
                            <div class="tab">
                                <div id="tab-inpt1" class="tab-content first-tab">
                                    {{ render(controller('App\\Controller\\ListingSearchController::searchHomeFormAction')) }}
                                </div>
                            </div>
                            <!--tab end-->
                        </div>
                        <!--tabs end-->
                    </div>
                </div>
                <div class="header-sec-link">
                    <a href="#sec1" class="custom-scroll-link"><i class="fal fa-angle-double-down"></i></a>
                </div>
            </section>
            <!--section end-->
        {% endblock %}

        {% block main %}
            <!--section  -->
            <section      data-scrollax-parent="true">
                <div class="container">
                    <div class="section-title">
                        <h2>{{ 'global.howItWorks'|trans }}</h2>
