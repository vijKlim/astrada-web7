{% extends "base.html.twig" %}

{% block layout %}
    {% embed 'layout.html.twig'%}
        {% block sub_header %}
            <!--style="background-image: url(/img/header/ti-fxx-header.png);"-->
            <section class="d-flex align-items-center blue-overlay bg-cover"  style="background-image: url(data:image/svg+xml;base64,);">
                <div class="container py-6 py-lg-7 text-white overlay-content text-center">
                    <div class="row">
                        <div class="col-xl-10 mx-auto">
                            <h1 class="display-4 font-weight-bold text-shadow">{{ 'home.header.title'|trans|raw }}</h1>
                            <p class="text-lg text-shadow">{{ 'home.header.description'|trans|raw }}</p>
                        </div>
                    </div>
                </div>
            </section>
        {% endblock %}

        {% block main %}
            <div class="container">
                <div class="search-bar rounded p-3 p-lg-4 position-relative mt-n5 z-index-20">
                    {{ render(controller('App\\Controller\\ListingSearchController::searchHomeFormAction')) }}
                </div>
            </div>

            <section class="py-6">
                <div class="container">
                    <div class="row mb-lg-6">
                        <div class="col-md-8">
                            <p class="subtitle text-secondary">{{ 'home.find_your_best_service_today'|trans|raw }}</p>
                            <h2 class="mb-md-0">{{ 'home.featured_listings_around_you'|trans|raw }}</h2>
                        </div>
                        <div class="col-md-4 d-md-flex align-items-center justify-content-end"><a class="text-muted text-sm" href="category-rooms.html">
                                {{ 'home.see_all_featured_listings'|trans|raw }}<i class="fas fa-angle-double-right ml-2"></i></a></div>
                    </div>
                </div>
                <div class="container-fluid">
                    <!-- Slider main container-->
                    <div id="nearby-listing-slides"></div>
                </div>
            </section>
            <!-- Our picks section-->


            <section class="py-6 bg-gray-100">
                <div class="container">
                    <div class="pb-lg-4">
                        <p class="subtitle text-secondary">{{ 'home.why_us'|trans|raw }}</p>
                        <h2 class="mb-5">{{ 'home.count_companies_hundreds_customers_day'|trans({ '%count%': 1505 }) | raw }}</h2>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 col-lg-4 mb-3 mb-lg-0">
                            <div class="px-0 pr-lg-4">
                                <div class="icon-rounded mb-3 bg-primary-light">
                                    <svg class="svg-icon w-2rem h-2rem text-primary">
                                        <use xlink:href="#pay-1"> </use>
                                    </svg>
                                </div>
                                <h3 class="h6 text-uppercase">Порівнюєте ціни</h3>
                                {#                                <p class="text-muted text-sm">His room, a proper human room although a little too small, lay peacefully between its four familiar </p>#}
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4 mb-3 mb-lg-0">
                            <div class="px-0 pr-lg-4">
                                <div class="icon-rounded mb-3 bg-secondary-light">
                                    <svg class="svg-icon w-2rem h-2rem text-secondary">
                                        <use xlink:href="#real-estate-1"> </use>
                                    </svg>
                                </div>
                                <h3 class="h6 text-uppercase">Вибираєте компанії</h3>
{#                                <p class="text-muted text-sm">The bedding was hardly able to cover it and seemed ready to slide off any moment. His many legs, pit</p>#}
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4 mb-3 mb-lg-0">
                            <div class="px-0 pr-lg-4">
                                <div class="icon-rounded mb-3 bg-primary-light">
                                    <svg class="svg-icon w-2rem h-2rem text-primary">
                                        <use xlink:href="#destination-map-1"> </use>
                                    </svg>
                                </div>
                                <h3 class="h6 text-uppercase">Створюєте заявку</h3>
                                {#                                <p class="text-muted text-sm">One morning, when Gregor Samsa woke from troubled dreams, he found himself transformed in his bed in</p>#}
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="py-6">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-left">
                            <p class="subtitle text-secondary">{{ 'home.start_using_directory_today'|trans|raw }}</p>
                            <p class="text-lg">{{ 'home.directory_short_description_promote'|trans|raw }}</p>
{#                            <p class="text-muted mb-0">One morning, when Gregor Samsa woke from troubled dreams, he found himself transformed in his bed in</p>#}
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-center">
                            <div class="text-center">
                                <p class="mb-2"><a class="btn btn-lg btn-primary" href="#">{{ 'home.create_your_account'|trans|raw }}</a></p>
{#                                <p class="text-muted text-small">It's free!</p>#}
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {% endblock %}

    {% endembed %}
{% endblock %}


{% block scripts %}

{#    {{ encore_entry_script_tags('business-list') }}#}
{% endblock %}
