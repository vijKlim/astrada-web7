{% block layout %}
    {% block header %}
        {% include '_partials/header.html.twig' with { pinned: false } %}
    {% endblock %}

    <!-- wrapper-->
    <div id="wrapper">
        {% block sub_header %}{% endblock %}
        <!-- content-->
        <div class="content">
            {% block main %}{% endblock %}
        </div>
        <a class="to-top"><i class="fas fa-caret-up"></i></a>
    </div>


    {% block footer %}
        {% include '_partials/footer.html.twig' only %}
    {% endblock %}
{% endblock %}
