{% extends "base.html.twig" %}

{% block layout %}
    {% embed 'layout.html.twig'%}

        {% block sub_header %}
            <div class="progress rounded-0 sticky-top" style="height: 8px; top: 71px;">
                <div class="progress-bar" role="progressbar" style="width: {{ flow.getCurrentStepNumber() * 30 }}%" aria-valuenow="{{ flow.getCurrentStepNumber() * 30 }}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

        {% endblock %}


        {% block main %}

            {% form_theme form 'form/frontend/listing.html.twig' %}

            <section class="py-5">
                <div class="container">
                    <p class="subtitle text-primary">{% trans %}listing.flow.add_new_listing{% endtrans %}</p>
                    <h1 class="h2 mb-5"> {{ flow.getCurrentStepLabel() | trans }} <span class="text-muted float-right">{% trans %}form.flow.step{% endtrans %} {{ flow.getCurrentStepNumber() }}</span>      </h1>
                    {{ form_start(form, {'action': path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')), 'attr': {'class': 'flow-form'}}) }}
                        <fieldset>

                            {{ form_errors(form) }}
                            {% if flow.getCurrentStepNumber() == 1 %}
                                <div class="row form-block">
                                    <div class="col-lg-4">
                                        <h4>{% trans %}listing.flow.owner_type{% endtrans %}</h4>
                                        <p class="text-muted text-sm">{% trans %}listing.flow.owner_type.description{% endtrans %}</p>
                                    </div>
                                    <div class="col-lg-7 ml-auto">
                                        <div class="form-group"></div>
                                        <div class="form-group">
                                            {{ form_row(form.business) }}
                                        </div>

                                    </div>
                                </div>

                            {% endif %}
                            {% if flow.getCurrentStepNumber() == 2 %}
                                <div class="row form-block">
                                    <div class="col-lg-4">
                                        <h4>Basic</h4>
                                        <p class="text-muted text-sm">His room, a proper human room although a little too small, lay peacefully between its four familiar walls. A collection of textile samples lay spread out on the table.</p>
                                    </div>
                                    <div class="col-lg-7 ml-auto">
                                        <div class="form-group"></div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label" for="guests">{{ form_label(form.business.name) }}</label>
                                                    {{ form_errors(form.business.name) }}
                                                    {{ form_widget(form.business.name, {'attr': { 'class': 'form-control'}}) }}
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label" for="guests">{{ form_label(form.business.legalName) }}</label>
                                                    {{ form_errors(form.business.legalName) }}
                                                    {{ form_widget(form.business.legalName, {'attr': { 'class': 'form-control'}}) }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label" for="guests">{{ form_label(form.business.telephone) }}</label>
                                                    {{ form_errors(form.business.telephone) }}
                                                    {{ form_widget(form.business.telephone, {'attr': { 'class': 'form-control'}}) }}
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label" for="guests">{{ form_label(form.business.website) }}</label>
                                                    {{ form_errors(form.business.website) }}
                                                    {{ form_widget(form.business.website, {'attr': { 'class': 'form-control'}}) }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="form-label" for="guests">{{ form_label(form.business.address) }}</label>
                                            {{ form_errors(form.business.address) }}
                                            {{ form_widget(form.business.address, {'attr': { 'class': 'form-control'}}) }}
                                        </div>


                                    </div>
                                </div>

                            {% endif %}

                            {% if flow.getCurrentStepNumber() == 3 %}

                            {% endif %}


                            {{ form_rest(form) }}
                        </fieldset>

                        {% include 'listingFlow/buttons.html.twig' with {
                            craue_formflow_button_class_last: 'btn btn-primary px-3',
                            craue_formflow_button_class_back: 'btn btn-link text-muted',
                        } %}

                    {{ form_end(form) }}
                </div>
            </section>

        {% endblock %}

    {% endembed %}
{% endblock %}

{#{% block styles %}#}
{#    {{ encore_entry_link_tags('frontend-listing-detail') }}#}
{#{% endblock %}#}

