<div class="card border-0 shadow">
    <div class="card-body p-4">
        <div class="text-block pb-3">
            <div class="media align-items-center">
                <div class="media-body">
                    <h6> <a class="text-reset" href="detail-rooms.html">{{ formData.listing.title }}</a></h6>
                    <p class="text-muted text-sm mb-0">{{ formData.business.name }}</p>
                    </div>
                </div>
{#                <a href="{{ listing_path(listing, listing_path_params) }}"><img class="ml-3 rounded" src="{{ listing_image }}" alt="" width="100"></a>#}
            </div>
        </div>
        <div class="text-block py-3">
            <ul class="list-unstyled mb-0">
                <li class="mb-3"><i class="fas fa-users fa-fw text-muted mr-2"></i>{{ formData.listing.address.streetAddress }}</li>

            </ul>
        </div>
        <div class="text-block pt-3 pb-0">
            <table class="w-100">
                <tbody>
                <tr>
                    <th class="font-weight-normal py-2">{{ 'listing.price.per_1km_delivery'|trans }}</th>
                    <td class="text-right py-2">{{ formData.listing.welldesign.transportationCost|price_format }}</td>
                </tr>
                <tr>
                    <th class="font-weight-normal pt-2 pb-3">{{ 'listing.price.per_1m_drilling'|trans }}</th>
                    <td class="text-right pt-2 pb-3">{{ formData.listing.welldesign.wellCost|price_format }}</td>
                </tr>
                </tbody>

            </table>
        </div>
    </div>

</div>
