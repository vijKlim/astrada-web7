<div class="row">
    {%- for listing in listings -%}
        {% set listing_translation = listing.translations[app.request.locale] %}
        {% set listing_address = listing.address %}
        {% set business = listing.business %}
        {% set business_image = astrada_asset(business, 'imageFile', 'business_thumbnail') %}
        {% if business_image is empty %}
            {% set business_image = '//via.placeholder.com/512.jpg' %}
        {% endif %}
        {#    {% set price = (listing.price / 100) |price_format %}#}
            {% set listing_image = astrada_asset(listing, 'imageFile', 'listing_thumbnail') %}
            {% if listing_image is empty %}
                {% set listing_image = '//via.placeholder.com/512.jpg' %}
            {% endif %}
{#        {% set listing_image = '//via.placeholder.com/512.jpg' %}#}
        {% set listing_path_params = {} %}


        <div class="col-sm-6 mb-5 hover-animate" data-marker-id="{{ listing.id }}">
            <div class="card h-100 border-0 shadow">
                <div class="card-img-top overflow-hidden dark-overlay bg-cover" style="background-image: url({{ listing_image }}); min-height: 200px;">
                    <a class="tile-link" href="{{ listing_path(listing, listing_path_params) }}"></a>
                    <div class="card-img-overlay-bottom z-index-20">
                        <h4 class="text-white text-shadow">{{ listing_translation.title }}</h4>
{#                        {{ listing.averageRating | astrada_star_rating }}#}
                    </div>
                    <div class="card-img-overlay-top d-flex justify-content-between align-items-center">
                        <div class="badge badge-transparent badge-pill px-3 py-2">123$</div><a class="card-fav-icon position-relative z-index-40" href="javascript: void();">
                            <svg class="svg-icon text-white">
                                <use xlink:href="#heart-1"> </use>
                            </svg></a>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-sm text-muted mb-3"> {{ listing_translation.description |u.truncate(125)}}</p>
                    <p class="text-sm text-muted text-uppercase mb-1">By <a href="#" class="text-dark">{{ business.name }}</a></p>
                    <p class="text-sm mb-0"><a class="mr-1" href="#">Маршрут,</a><a class="mr-1" href="#">Контакти</a>
                    </p>
                </div>
            </div>
        </div>



    {%- else -%}
        {{ 'listing.search.result.no_results'|trans }}
    {%- endfor -%}

    <div data-id="nb-result-map-drag"
         style="color: transparent">{{ 'listing.search.result.results'|trans({'%nb_results%': nb_listings}) }}</div>


</div>
