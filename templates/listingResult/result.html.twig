{% extends "base.html.twig" %}


{% block layout %}
    {% embed 'map-layout.html.twig'%}


        {% block main %}
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-6 py-5 p-xl-5">
                        <h1 class="text-serif mb-4">{{ search_address.streetAddress }}</h1>
                        <hr class="my-4">

                        {% include 'form/map_search.html.twig' with {
                            'form': form,
                            'addresses_normalized': addresses_normalized
                        } only %}


                        <hr class="my-4">
                        <div class="d-flex justify-content-between align-items-center flex-column flex-md-row mb-4">
                            <div class="mr-3">
                                <p class="mb-3 mb-md-0"><strong>{{ nb_listings }}</strong> results found</p>
                            </div>
                        </div>
                        <!-- listing-items  -->
                        {% include 'listingResult/_result_listings.html.twig'  with {
                            'listings': listings,
                            'nb_listings': nb_listings
                        } only %}
                        <!-- listing-items end -->

                        <!-- Pagination -->
                        {% include 'common/_pagination.html.twig' with {
                            'pagination': pagination
                        } only %}


                    </div>
                    <div class="col-lg-6 map-side-lg pr-lg-0">
                        <div class="map-full shadow-left" id="categorySideMap"
                             data-listings="{{ listingsNormalized|json_encode|e('html_attr') }}"></div>
                    </div>
                </div>
            </div>

        {% endblock %}





    {% endembed %}

{% endblock layout %}

{% block styles %}
    <style>
        body {
            padding-top: 72px;
        }
    </style>

    {{ encore_entry_link_tags('frontend-map-category') }}
{% endblock %}

{% block scripts %}
    {{ encore_entry_script_tags('frontend-map-category') }}

{% endblock %}