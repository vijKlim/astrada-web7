{% extends "base.html.twig" %}

{#{% set location = listing_search_request.location %}#}
{% set search_address = "Адрес поиска" %}
{# SEO #}
{% set seo_title = 'listing.search.result.title'|trans({'%listing_search_request%': search_address }) %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        #map-canvas {
            width: {{ listing_search_map_w }}px;
            height: {{ listing_search_map_h }}px;
        }
    </style>
{% endblock %}


{% block layout %}
    {% embed 'map-layout.html.twig'%}


        {% block main %}


            <div id="mapboard"
                 data-listings="{{ listings|json_encode|e('html_attr') }}"
                 data-pagination="{{ pagination|json_encode|e('html_attr') }}"
                 data-seotitle="{{ seo_title }}"
                 data-searchform-schema="{{ json_searchform_schema }}"
            ></div>


        {% endblock %}





    {% endembed %}

{% endblock layout %}

{% block styles %}
    {{ encore_entry_link_tags('mapboard') }}
{% endblock %}

{% block scripts %}
    {{ encore_entry_script_tags('mapboard') }}
{% endblock %}