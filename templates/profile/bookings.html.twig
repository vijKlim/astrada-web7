{% extends "base.html.twig" %}

{% block layout %}
    {% embed 'profile.html.twig'%}

        {% block breadcrumb %}
            <li class="breadcrumb-item">Bookings</li>
        {% endblock %}

        {% block main %}

            <div class="d-flex justify-content-between align-items-end mb-5">
                <h1 class="hero-heading mb-0">{{ 'profile.bookings.your_nearest_bookings'|trans }}</h1>
                <a class="btn btn-link text-muted" href="#">Past bookings</a>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-column flex-lg-row mb-5">
                <div class="mr-3">
                    <p class="mb-3 mb-lg-0">{{ 'profile.bookings.booking_total'|trans({ '%count%': bookings.getTotalItemCount }) | raw }}</p>
                </div>

            </div>
            <div class="list-group shadow mb-5">
                {% for booking in bookings %}
                    <a class="list-group-item list-group-item-action p-4" href="{{ path('profile_booking', { id: booking.id }) }}">
                        <div class="row">
                            <div class="col-lg-4 align-self-center mb-4 mb-lg-0">
                                <div class="d-flex align-items-center mb-3">
                                    <h2 class="h5 mb-0">{{ booking.listing.title }}</h2><img class="avatar avatar-sm avatar-border-white ml-3" src="img/avatar/avatar-0.jpg" alt="Jack London">
                                </div>
                                <p class="text-sm text-muted">Double Room</p><span class="badge badge-pill p-2 badge-secondary-light">February 16, 2019 - February 19, 2019</span>
                            </div>
                            <div class="col-lg-8">
                                <div class="row">
                                    <div class="col-6 col-md-4 col-lg-3 py-3 mb-3 mb-lg-0">
                                        <h6 class="label-heading">Rate type</h6>
                                        <p class="text-sm font-weight-bold">Bed & Breakfast</p>
                                        <h6 class="label-heading">Nights </h6>
                                        <p class="text-sm font-weight-bold mb-0">3</p>
                                    </div>

                                    <div class="col-6 col-md-4 col-lg-3 py-3">
                                        <h6 class="label-heading">Booked Date</h6>
                                        <p class="text-sm font-weight-bold">{{ booking.start|date_calendar }}</p>

                                    </div>
                                    <div class="col-6 col-md-4 col-lg-3 py-3">
                                        <h6 class="label-heading">Messages</h6>
                                        <p class="text-sm font-weight-bold">{{ booking.topic.postCount }}</p>

                                    </div>
                                    <div class="col-12 col-lg-3 align-self-center">
                                        <span class="text-primary text-sm text-uppercase mr-4 mr-lg-0">
                                            <i class="fa fa-check fa-fw mr-2"> </i>Booking paid</span>
                                        <br class="d-none d-lg-block">
                                        <span class="text-primary text-sm text-uppercase">
                                            <i class="fa fa-check fa-fw mr-2"> </i>Confirmed
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>

            <!-- Pagination -->
            {{ knp_pagination_render(bookings,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig',{}, {
                'align': 'center',
                'rounded': true,
            }) }}

        {% endblock %}

    {% endembed %}
{% endblock %}


{% block scripts %}

{% endblock %}

