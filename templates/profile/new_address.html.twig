{% extends "base.html.twig" %}

{% block layout %}
    {% embed 'profile.html.twig'%}

        {% block breadcrumb %}
            <li class="breadcrumb-item">{% trans %}profile.addresses.newAddress{%  endtrans %}</li>
        {% endblock %}

        {% block main %}

            <h1 class="hero-heading mb-0">{% trans %}profile.addresses.newAddress{%  endtrans %}</h1>
            <p class="text-muted mb-5">Manage your Addresses.</p>
            <div class="row">
                        <div class="col-lg-7">
                            <div class="text-block">
                                {{ form_start(form) }}


                                <div class="row pt-4">
                                    <div class="form-group col-md-12">
                                        {{ form_label(form.streetAddress, null, { label_attr: { class: 'form-label' } }) }}
                                        {{ form_widget(form.streetAddress, { attr: { class: "form-control" } }) }}
                                    </div>
                                    <div class="form-group col-md-6">

                                        {{ form_label(form.name, null, { label_attr: { class: 'form-label' } }) }}
                                        {{ form_widget(form.name, { attr: { class: "form-control" } }) }}
                                    </div>
                                    <div class="form-group col-md-6">
                                        {{ form_label(form.description, null, { label_attr: { class: 'form-label' } }) }}
                                        {{ form_widget(form.description, { attr: { class: "form-control" } }) }}
                                    </div>

                                </div>
                                <button type="submit" class="btn btn-outline-primary">{% trans %}basics.save{% endtrans %}</button>
                                {{ form_end(form) }}

                            </div>

                        </div>

                    </div>
        {% endblock %}

    {% endembed %}
{% endblock %}


{% block scripts %}

{% endblock %}

